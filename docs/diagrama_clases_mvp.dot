digraph UML {
  graph [rankdir=LR, splines=polyline, bgcolor="white", nodesep="0.35", ranksep="0.7", pad="0.25", labelloc=t, label="MedAgenda · MVP con acceso por roles", fontname="DejaVu Sans", fontsize=18, fontcolor="#103b44"];
  node [shape=record,fontname="DejaVu Sans",fontsize=10,style="filled",fillcolor="#f4faf8",color="#2e8074",penwidth=1.3,fontcolor="#183c45",margin="0.13,0.1"];
  edge [color="#62848a",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
  user [label="{Usuario|+ id: int\l+ usuario: str\l+ nombre: str\l+ rol: str\l+ doctor_id: str?\l+ paciente_id: int?\l}"];
  auth [label="{AutenticacionService| - sesiones: dict\l+ login(usuario, clave)\l+ validar(token): Usuario\l+ logout(token)\l+ exigir(usuario, roles)\l+ usuarios()\l}",fillcolor="#e1f3ed"];
  service [label="{HospitalService|+ listar_doctores()\l+ disponibilidad(id,fecha,duracion)\l+ listar_citas(fecha, doctor)\l+ agendar(...)\l+ cancelar(cita_id)\l+ registrar_doctor(...)\l+ resumen()\l}",fillcolor="#e1f3ed"];
  dr [label="{Doctor|+ id: str\l+ nombre: str\l+ especialidad: str\l}"];
  pt [label="{Paciente|+ id: int\l+ nombre: str\l+ telefono: str\l}"];
  ap [label="{CitaMedica|+ id: int\l+ doctor_id: str\l+ paciente_id: int\l+ fecha: str\l+ inicio: int\l+ duracion: int\l+ estado: str\l}"];
  handler [label="{Handler (HTTP)|+ do_GET()\l+ do_POST()\l+ enviar(...)\l}",fillcolor="#f1f5fb",color="#6b8fb4"];
  role [shape=note,label="Roles de demostración:\n• administrador\n• doctor\n• paciente\n• recepcion\n• personal_autorizado",fillcolor="#fff8e8",color="#d8b875"];
  service -> dr [label="administra 1..*"];
  service -> pt [label="registra 0..*"];
  service -> ap [label="gestiona 0..*"];
  ap -> dr [label="1 médico"];
  ap -> pt [label="1 paciente"];
  auth -> user [label="verifica 1..*"];
  user -> dr [style=dashed,label="doctor_id (opcional)"];
  user -> pt [style=dashed,label="paciente_id (opcional)"];
  user -> role [style=dotted, arrowhead=none];
  handler -> auth [label="autentica"];
  handler -> service [label="delegación"];
}
