digraph HospitalUML {
  graph [rankdir=TB, bgcolor="white", splines=ortho, nodesep=0.42, ranksep=0.58,
         pad=0.22, fontname="DejaVu Sans", fontsize=16,
         label="Gestor de citas médicas — Diagrama de clases", labelloc=t];
  node [shape=record, style="filled", fontname="DejaVu Sans", fontsize=10,
        fillcolor="#f4faf8", color="#247d71", fontcolor="#1a3940", margin="0.14,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#527580", arrowsize=.65];

  Usuario [label="{Usuario|+ id: int\l+ usuario: str\l+ nombre: str\l+ rol: str\l+ doctor_id: str?\l+ paciente_id: int?\l}"];
  Doctor [label="{Doctor|+ id: str\l+ nombre: str\l+ especialidad: str\l+ activo: bool\l}"];
  Paciente [label="{Paciente|+ id: int\l+ nombre: str\l+ telefono: str\l+ correo: str\l}"];
  CitaMedica [label="{CitaMedica|+ id: int\l+ doctor_id: str\l+ paciente_id: int\l+ fecha: str\l+ inicio: int\l+ duracion: int\l+ estado: programada/cancelada/pendiente_reagendar\l}"];
  Ausencia [label="{Ausencia|+ id: int\l+ doctor_id: str\l+ fecha: str\l+ motivo: str\l}"];
  Notificacion [label="{Notificacion|+ id: int\l+ paciente_id: int\l+ cita_id: int\l+ tipo: str\l+ mensaje: str\l+ leida: bool\l}"];
  Intervalo [label="{Intervalo|+ inicio: int\l+ fin: int\l}"];
  AutenticacionService [fillcolor="#e5f2ee",label="{AutenticacionService|+ login(usuario,clave)\l+ validar(token)\l+ logout(token)\l+ crear_usuario(...)\l+ actualizar_usuario(...)\l+ eliminar_usuario(...)\l}"];
  HospitalService [fillcolor="#e5f2ee",label="{HospitalService|+ registrar_paciente(...)\l+ listar_pacientes()\l+ registrar_doctor(...)\l+ impacto_doctor(id)\l+ directorio_medicos()\l+ dar_baja_doctor(id)\l+ reactivar_doctor(id)\l+ disponibilidad(...)\l+ agendar(...)\l+ reprogramar(...)\l+ cancelar(...)\l+ proximas_citas(...)\l+ notificar_ausencia(...)\l+ levantar_ausencia(id)\l+ notificaciones(...)\l}"];
  Handler [fillcolor="#edf3fc",color="#718bb0",label="{Handler (HTTP)|+ do_GET()\l+ do_POST()\l+ enviar(...)\l}"];

  {rank=same; Usuario; Doctor; Paciente;}
  {rank=same; CitaMedica; Ausencia; Notificacion;}
  {rank=same; AutenticacionService; HospitalService; Handler;}

  CitaMedica -> Doctor [label="1"];
  CitaMedica -> Paciente [label="1"];
  Ausencia -> Doctor [label="1"];
  Notificacion -> Paciente [label="1"];
  Notificacion -> CitaMedica [label="1"];
  Usuario -> Doctor [style=dashed, label="0..1"];
  Usuario -> Paciente [style=dashed, label="0..1"];
  AutenticacionService -> Usuario [label="gestiona"];
  HospitalService -> CitaMedica [label="gestiona"];
  HospitalService -> Ausencia [label="registra"];
  HospitalService -> Notificacion [label="envía"];
  HospitalService -> Intervalo [label="calcula"];
  Handler -> HospitalService [style=dashed,label="utiliza"];
  Handler -> AutenticacionService [style=dashed,label="utiliza"];
}
